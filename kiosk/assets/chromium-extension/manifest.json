{
  "manifest_version": 3,
  "name": "Home Media Player: YouTube TV helper",
  "version": "2.0",
  "description": "Lets YouTube TV's exit return to the kiosk and prefers H.264 streams.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["config.js", "page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["bridge.js"],
      "css": ["hide-cursor.css"],
      "run_at": "document_start"
    }
  ]
}
