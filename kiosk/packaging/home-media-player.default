# Settings for the Home Media Player kiosk.
# Apply with: systemctl restart home-media-player

# HDMI mode. 4K is too heavy for this GPU, so 1080p is the default.
# Empty keeps the TV's preferred mode.
HMP_OUTPUT_MODE=1920x1080

# Text size multiplier for the 10-foot UI.
#HMP_TEXT_SCALE=1.5

# Folders listed on the Media screen next to the disks, Name=/path;Name=/path
#HMP_BOOKMARKS="Downloads=/srv/downloads"

# YouTube TV
#HMP_YOUTUBE_URL=https://www.youtube.com/tv
#HMP_YOUTUBE_USER_AGENT="Mozilla/5.0 (PS4; Leanback Shell) Gecko/20100101 Firefox/65.0 LeanbackShell/01.00.01.75 Sony PS4/ (PS4, , no, CH)"
# Hide VP9/AV1 so YouTube streams H.264, which the CPU decodes more easily.
#HMP_YOUTUBE_FORCE_H264=1
#HMP_CHROMIUM_FLAGS=

# mpv hwdec for local videos. With hmp-hwdec-libs and the hwdec kernel it is
# v4l2request (hardware H.264/HEVC/VP9/MPEG-2, software for the rest);
# otherwise no (software, ~1.3 cores for 1080p24 H.264). v4l2request-copy
# copies frames back to memory, for debugging display problems.
#HMP_HWDEC=no
# Extra mpv properties, name=value;name=value
#HMP_MPV_OPTIONS="audio-device=alsa/default;sub-auto=fuzzy"

# Flutter renders with Skia; Impeller crashed on this GPU (Mali-G31/Panfrost).
#HMP_IMPELLER=1

# Log every key press to the journal (to map a new remote).
#HMP_DEBUG_KEYS=1
