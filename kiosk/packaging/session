#!/bin/sh
# Runs inside cage: pick the HDMI mode, then become the kiosk app.

if [ -n "$HMP_OUTPUT_MODE" ]; then
    for output in $(wlr-randr | awk '/^[^ ]/ {print $1}'); do
        wlr-randr --output "$output" --mode "$HMP_OUTPUT_MODE" ||
            echo "session: could not set $output to $HMP_OUTPUT_MODE" >&2
    done
fi

# cage itself uses the transparent cursor theme (see the service), so nothing
# shows until an app sets a pointer; apps get a real theme and show it only
# while the mouse is being used.
unset XCURSOR_PATH
export XCURSOR_THEME=Adwaita XCURSOR_SIZE=32

export GDK_BACKEND=wayland

# hmp-hwdec-libs: FFmpeg with the V4L2 request API and a libmpv built on it,
# used by the player instead of Debian's (Chromium drops it again)
HWDEC_LIBS=/usr/lib/home-media-player/hwdec/lib
if [ -e "$HWDEC_LIBS/libmpv.so.2" ]; then
    export LD_LIBRARY_PATH="$HWDEC_LIBS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

exec /opt/home-media-player/home_media_player "$@"
