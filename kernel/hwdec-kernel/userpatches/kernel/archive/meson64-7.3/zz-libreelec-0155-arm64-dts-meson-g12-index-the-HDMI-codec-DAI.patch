From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Christian Hewitt <christianshewitt@gmail.com>
Date: Tue, 15 Sep 2026 01:08:46 +0000
Subject: [PATCH] arm64: dts: meson: g12: index the HDMI codec DAI

hdmi_tx has an I2S and an S/PDIF DAI, so a link must say which one it
uses. Add a sound-dai cell to the node; the boards that bind it already
name the I2S DAI.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Christian Hewitt <christianshewitt@gmail.com>
---
 arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi | 2 +-
 arch/arm64/boot/dts/amlogic/meson-sm1-odroid.dtsi | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi b/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
index 7764f14ff..c007ba036 100644
--- a/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-g12-common.dtsi
@@ -212,7 +212,7 @@ hdmi_tx: hdmi-tx@0 {
 				clock-names = "isfr", "iahb", "venci";
 				#address-cells = <1>;
 				#size-cells = <0>;
-				#sound-dai-cells = <0>;
+				#sound-dai-cells = <1>;
 				status = "disabled";
 
 				assigned-clocks = <&clkc CLKID_HDMI_SEL>,
diff --git a/arch/arm64/boot/dts/amlogic/meson-sm1-odroid.dtsi b/arch/arm64/boot/dts/amlogic/meson-sm1-odroid.dtsi
index 25d14901a..fb48be6f8 100644
--- a/arch/arm64/boot/dts/amlogic/meson-sm1-odroid.dtsi
+++ b/arch/arm64/boot/dts/amlogic/meson-sm1-odroid.dtsi
@@ -232,7 +232,7 @@ dai-link-4 {
 			sound-dai = <&tohdmitx TOHDMITX_I2S_OUT>;
 
 			codec {
-				sound-dai = <&hdmi_tx>;
+				sound-dai = <&hdmi_tx 0>;
 			};
 		};
 	};
